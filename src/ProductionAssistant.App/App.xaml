<Application
    x:Class="ProductionAssistant.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="BrandAccent">#C2703D</Color>
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccent}" />
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FAFAF9" />
            <SolidColorBrush x:Key="GlassCardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="GlassStrongBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="GlassSidebarBrush" Color="#FAFAF9" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E7E5E4" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#78716C" />
            <SolidColorBrush x:Key="NavSelectedBrush" Color="#F5EBE3" />
            <SolidColorBrush x:Key="NavHoverBrush" Color="#F5F5F4" />
            <SolidColorBrush x:Key="GlassSubtleBrush" Color="#F5F5F4" />
            <Style x:Key="SidebarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#70FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="12,0" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
            <Style x:Key="StatCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="BorderThickness" Value="1,3,1,1" />
                <Setter Property="Padding" Value="17,14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
