<Window
    x:Class="ProductionAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="生产助手">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="222" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Frame x:Name="ShellFrame" Grid.RowSpan="2" Grid.ColumnSpan="2" />
        <Frame x:Name="ContentFrame" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" />
        <Grid x:Name="AppTitleBar" Grid.Column="1" Margin="0,0,140,0" />
    </Grid>
</Window>
