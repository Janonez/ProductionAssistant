<Page
    x:Class="ProductionAssistant.Pages.DailyReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel MaxWidth="1180" Margin="36,26,36,40" Spacing="16"
                        HorizontalAlignment="Stretch">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PageTitleText" FontSize="30" FontWeight="SemiBold" Text="日报自动推送" />
                    <TextBlock x:Name="PageDescriptionText" Foreground="{StaticResource MutedTextBrush}"
                               Text="从多个 Notion 数据库读取当天数据，生成固定文字并自动发送到钉钉群。" />
                </StackPanel>

                <InfoBar x:Name="StatusInfoBar" IsOpen="True" IsClosable="False"
                         Severity="Informational" Title="正在读取配置" />

                <Grid x:Name="ContentGrid" ColumnSpacing="16" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="TemplateContent" Spacing="16" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource CardStyle}" Padding="18"
                                HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="消息模板" />
                                <Border MinHeight="250" BorderBrush="{ThemeResource TextControlBorderBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        Background="{ThemeResource TextControlBackground}">
                                    <WebView2 x:Name="TemplateEditor" MinHeight="248" />
                                </Border>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                           Text="输入固定文字并自由换行；插入的日期和 Notion 字段会显示为可整体选择和删除的胶囊。" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="InsertTodayButton" Content="插入业务日期"
                                            IsEnabled="False" Click="InsertTodayButton_Click" />
                                    <Button Content="保存草稿" Click="SaveDraftButton_Click" />
                                    <Button Content="启用当前模板" Style="{StaticResource AccentButtonStyle}"
                                            Click="ActivateTemplateButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="预览与测试" />
                                <CalendarDatePicker x:Name="PreviewDatePicker" Header="选择测试日期"
                                                    Width="180" HorizontalAlignment="Left" />
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                           Text="可选择任意有数据的历史日期；该日期用于业务日期胶囊，并按对应的日、月、年查询 Notion。" />
                                <TextBox x:Name="PreviewBox" MinHeight="170" AcceptsReturn="True"
                                         IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="生成预览" Click="PreviewButton_Click" />
                                    <Button Content="测试发送到群" Click="TestSendButton_Click" />
                                    <ProgressRing x:Name="BusyRing" Width="22" Height="22"
                                                  IsActive="False" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ConfigurationContent" Grid.Column="1" Spacing="16" HorizontalAlignment="Stretch">
                        <Border x:Name="FieldConfigurationCard" Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="插入 Notion 字段" />
                                <ComboBox x:Name="DataSourceBox" Header="数据库"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="DataSourceBox_SelectionChanged" />
                                <TextBlock x:Name="SourceDetectionText"
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                           Text="选择数据库后，程序会自动识别日库、月库或年库及其日期字段。" />
                                <ComboBox x:Name="ValuePropertyBox" Header="要插入的数据字段"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="ValuePropertyBox_SelectionChanged" />
                                <TextBox x:Name="FormatBox" Header="显示格式（可选）"
                                         PlaceholderText="数字如 0.0；日期如 MM月dd日" />
                                <Button x:Name="InsertFieldButton" Content="插入到模板光标处"
                                        IsEnabled="False" Click="InsertFieldButton_Click" />
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                           Text="胶囊按“周期 · 数据库 · 字段”显示，内部仍使用稳定字段 ID。" />
                                <TextBlock x:Name="BindingSummaryText" Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" Text="尚未绑定数据源" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="DingTalkConfigurationCard" Visibility="Collapsed"
                                Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="钉钉机器人" />
                                <PasswordBox x:Name="WebhookBox" Header="Webhook"
                                             PlaceholderText="留空表示保留已保存值" />
                                <PasswordBox x:Name="SecretBox" Header="加签 Secret"
                                             PlaceholderText="留空表示保留已保存值" />
                                <TextBlock x:Name="WebhookMaskText" Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="SecretMaskText" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="DingTalkConnectionText" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="保存配置" Click="SaveDingTalkButton_Click" />
                                    <Button Content="检测连接" Click="CheckDingTalkButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ScheduleConfigurationCard" Visibility="Collapsed"
                                Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="定时发送" />
                                <TimePicker x:Name="SendTimePicker" Header="每天发送时间"
                                            MinuteIncrement="5" ClockIdentifier="24HourClock"
                                            TimeChanged="SendTimePicker_TimeChanged" />
                                <TextBlock x:Name="TaskStatusText" Text="正在读取任务状态" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="安装 / 更新任务" Click="InstallTaskButton_Click" />
                                    <Button Content="停用任务" Click="RemoveTaskButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="RunRecordCard" Visibility="Collapsed"
                                Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="运行记录" />
                                <TextBlock x:Name="RunStatusText" Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                           Text="这里只显示本机最近一次自动运行状态；详细脱敏日志保存在本地应用数据目录。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
