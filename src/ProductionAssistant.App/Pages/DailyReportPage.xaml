<Page x:Class="ProductionAssistant.Pages.DailyReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Margin="36,26,36,40" Spacing="16" HorizontalAlignment="Stretch">
                <Grid>
                    <StackPanel>
                        <TextBlock FontSize="30" FontWeight="SemiBold" Text="日报自动推送" />
                        <TextBlock x:Name="PageDescriptionText" Foreground="{StaticResource MutedTextBrush}"
                                   Text="管理日报内容、推送计划和运行记录。" />
                    </StackPanel>
                    <Button x:Name="NewJobButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}" Content="新建日报任务" Click="NewJobButton_Click" />
                </Grid>
                <InfoBar x:Name="StatusInfoBar" IsOpen="True" IsClosable="False"
                         Severity="Informational" Title="正在读取配置" />

                <StackPanel x:Name="JobListPanel" Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="任务列表" />
                    <ListView x:Name="JobList" Margin="-6,0" Padding="0"
                              HorizontalContentAlignment="Stretch"
                              IsItemClickEnabled="True" SelectionMode="None"
                              ItemClick="JobList_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="18" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="CornerRadius" Value="14" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Grid Background="Transparent">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal" />
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="OuterShadow.Opacity" Value="1" />
                                                                <Setter Target="InnerShadow.Opacity" Value="1" />
                                                                <Setter Target="CardSurface.Background" Value="#E8FFFFFF" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="OuterShadow.Opacity" Value="1" />
                                                                <Setter Target="InnerShadow.Opacity" Value="1" />
                                                                <Setter Target="CardSurface.Background" Value="#E8F2F2F2" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Selected" />
                                                        <VisualState x:Name="PointerOverSelected">
                                                            <VisualState.Setters>
                                                                <Setter Target="OuterShadow.Opacity" Value="1" />
                                                                <Setter Target="InnerShadow.Opacity" Value="1" />
                                                                <Setter Target="CardSurface.Background" Value="#E8FFFFFF" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="PressedSelected">
                                                            <VisualState.Setters>
                                                                <Setter Target="OuterShadow.Opacity" Value="1" />
                                                                <Setter Target="InnerShadow.Opacity" Value="1" />
                                                                <Setter Target="CardSurface.Background" Value="#E8F2F2F2" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                    <VisualStateGroup x:Name="FocusStates">
                                                        <VisualState x:Name="Unfocused" />
                                                        <VisualState x:Name="PointerFocused" />
                                                        <VisualState x:Name="Focused">
                                                            <VisualState.Setters>
                                                                <Setter Target="FocusBorder.Opacity" Value="1" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>

                                                <Border x:Name="OuterShadow" Margin="0" CornerRadius="20"
                                                        Background="#08000000" Opacity="0" />
                                                <Border x:Name="InnerShadow" Margin="2" CornerRadius="18"
                                                        Background="#0D000000" Opacity="0" />
                                                <Border x:Name="CardSurface" Margin="6" CornerRadius="14"
                                                        Background="{StaticResource GlassCardBrush}"
                                                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                      Padding="{TemplateBinding Padding}"
                                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                                <Border x:Name="FocusBorder" Margin="6" CornerRadius="14"
                                                        BorderBrush="{ThemeResource SystemControlFocusVisualPrimaryBrush}"
                                                        BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding ScheduleText}" />
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding DingTalkStatus}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="6">
                                            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding LastRunText}" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyJobsText" Visibility="Collapsed" HorizontalAlignment="Center"
                               Margin="0,40" Foreground="{StaticResource MutedTextBrush}"
                               Text="还没有日报任务，点击“新建日报任务”开始配置。" />
                </StackPanel>

                <StackPanel x:Name="JobDetailPanel" Visibility="Collapsed" Spacing="16">
                    <Button Content="← 返回任务列表" HorizontalAlignment="Left" Click="BackButton_Click" />

                    <Border Style="{StaticResource CardStyle}" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="任务概览" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="JobNameBox" Header="任务名称" TextChanged="JobNameBox_TextChanged" />
                                <TimePicker Grid.Column="1" x:Name="SendTimePicker" Header="每天发送时间" MinuteIncrement="5"
                                            ClockIdentifier="24HourClock" TimeChanged="SendTimePicker_TimeChanged" />
                            </Grid>
                            <TextBlock x:Name="JobOverviewText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="TaskStatusText" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="EnableJobButton" Style="{StaticResource AccentButtonStyle}"
                                        Content="启用任务" Click="EnableJobButton_Click" />
                                <Button Content="测试发送" Click="TestSendButton_Click" />
                                <Button x:Name="ApplyScheduleButton" Content="应用定时设置" Visibility="Collapsed"
                                        Click="ApplyScheduleButton_Click" />
                                <Button x:Name="DeleteJobButton" Content="删除任务" Click="DeleteJobButton_Click" />
                                <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False" Visibility="Collapsed" />
                            </StackPanel>
                            <InfoBar x:Name="OverviewStatusInfoBar" IsOpen="False" IsClosable="True" />
                            <InfoBar x:Name="ScheduleStatusInfoBar" IsOpen="False" IsClosable="True" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="18">
                        <StackPanel Spacing="10">
                            <Grid x:Name="ContentWorkspace" ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Grid.Column="0">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Text="消息模板" />
                                    <ToggleSwitch x:Name="PreviewModeSwitch" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  OffContent="编辑" OnContent="实时预览"
                                                  Toggled="PreviewModeSwitch_Toggled" />
                                </Grid>
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="18" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Text="插入数据源" />
                                <StackPanel x:Name="EditorPanel" Grid.Row="1" Grid.Column="0" Spacing="10">
                                    <Grid>
                                        <Border x:Name="EditorBorder" MinHeight="360" BorderBrush="{ThemeResource TextControlBorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Background="{ThemeResource TextControlBackground}">
                                            <WebView2 x:Name="TemplateEditor" MinHeight="358" />
                                        </Border>
                                        <TextBox x:Name="PreviewBox" MinHeight="360" AcceptsReturn="True" IsReadOnly="True"
                                                 TextWrapping="Wrap" VerticalContentAlignment="Top" Visibility="Collapsed" />
                                    </Grid>
                                    <CalendarDatePicker x:Name="PreviewDatePicker" Header="预览业务日期" Width="180" HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="保存模板" Style="{StaticResource AccentButtonStyle}" Click="SaveDraftButton_Click" />
                                        <Button Content="发布为任务版本" Click="ActivateTemplateButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <Border x:Name="FieldPanel" Grid.Row="1" Grid.Column="1" BorderThickness="0" Padding="0">
                                    <Grid RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ComboBox Grid.Row="0" x:Name="DataPageBox" Header="1. 业务板块" PlaceholderText="请选择业务板块"
                                                  HorizontalAlignment="Stretch" SelectionChanged="DataPageBox_SelectionChanged" />
                                        <ComboBox Grid.Row="1" x:Name="DataSourceBox" Header="2. 数据库" PlaceholderText="请选择原始数据库"
                                                  HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                                                  SelectionChanged="DataSourceBox_SelectionChanged" />
                                        <ComboBox Grid.Row="2" x:Name="ValuePropertyBox" Header="3. 数据字段" PlaceholderText="请选择数据字段"
                                                  HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                                                  SelectionChanged="ValuePropertyBox_SelectionChanged" />
                                        <Button Grid.Row="3" x:Name="InsertFieldButton" Content="插入到模板光标处" IsEnabled="False" Click="InsertFieldButton_Click" />
                                        <InfoBar Grid.Row="4" x:Name="NotionStatusInfoBar" IsOpen="False" IsClosable="True" />
                                        <Button Grid.Row="6" x:Name="InsertTodayButton" Content="插入业务日期胶囊" IsEnabled="False" Click="InsertTodayButton_Click" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <InfoBar x:Name="ContentStatusInfoBar" IsOpen="False" IsClosable="True" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="推送配置" />
                            <TextBlock x:Name="DingTalkConnectionText" TextWrapping="Wrap" />
                            <StackPanel x:Name="DingTalkEditPanel" Spacing="0">
                                <Grid Height="64" Padding="16,0" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="Webhook" />
                                        <TextBlock x:Name="WebhookStatusText" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <PasswordBox Grid.Column="1" x:Name="WebhookBox" VerticalAlignment="Center"
                                                 PasswordRevealMode="Peek" PlaceholderText="留空则保持已保存的值" />
                                </Grid>
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid Height="64" Padding="16,0" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="加签 Secret" />
                                        <TextBlock x:Name="SecretStatusText" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <PasswordBox Grid.Column="1" x:Name="SecretBox" VerticalAlignment="Center"
                                                 PasswordRevealMode="Peek" PlaceholderText="留空则保持已保存的值" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="SaveDingTalkButton" Content="保存配置" Click="SaveDingTalkButton_Click" />
                                <Button Content="检测连接" Click="CheckDingTalkButton_Click" />
                            </StackPanel>
                            <InfoBar x:Name="DingTalkStatusInfoBar" IsOpen="False" IsClosable="True" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="18">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="最近运行记录" />
                                <Button x:Name="ShowAllRunsButton" HorizontalAlignment="Right" Content="查看全部"
                                        Click="ShowAllRunsButton_Click" />
                            </Grid>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="显示最近 5 条；每个任务仍保留最近 100 条。" />
                            <ListView x:Name="RunRecordList" SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="RunRecordList_ItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SourceText}" />
                                            <TextBlock Grid.Column="2" Text="{Binding DetailText}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
