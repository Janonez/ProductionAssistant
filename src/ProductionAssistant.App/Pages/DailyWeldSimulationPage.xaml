<Page
    x:Class="ProductionAssistant.Pages.DailyWeldSimulationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ProductionAssistant.Models">
    <Page.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot"
          Padding="32,24,32,32"
          RowSpacing="18"
          Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button x:Name="QuantityEditFocusTarget"
                Width="1"
                Height="1"
                Padding="0"
                Margin="-100,-100,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsTabStop="False"
                Opacity="0" />

        <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}"
                       FontSize="32"
                       FontWeight="Bold"
                       Text="每日焊接数据模拟" />
            <TextBlock x:Name="PageDescriptionText" Style="{StaticResource DescriptionStyle}"
                       Text="按真实月份生成每日焊接数量，生成结果严格保持月度计划总量。" />
        </StackPanel>

        <Border x:Name="ConfigurationContent" Grid.Row="1" Visibility="Collapsed"
                Style="{StaticResource CardStyle}" Padding="18" VerticalAlignment="Top">
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Notion 数据库绑定" />
                <TextBlock Style="{StaticResource DescriptionStyle}" TextWrapping="Wrap"
                           Text="选择每日焊接数据使用的 Notion 数据源，并检测日期与数量字段。" />
                <InfoBar x:Name="NotionBindingInfoBar" MinWidth="0"
                         HorizontalAlignment="Stretch" IsOpen="True" IsClosable="False"
                         Severity="Informational" Title="数据库" Message="未连接">
                    <InfoBar.ActionButton>
                        <Button x:Name="BindNotionButton" Click="BindNotionButton_Click" Content="绑定" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="UseContent" Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollMode="Auto"
                      HorizontalContentAlignment="Stretch">
        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Style="{StaticResource SectionTitleStyle}"
                           FontSize="22"
                           Text="模拟结果" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        x:Name="RightOperationPanel"
                        VerticalAlignment="Top"
                        SizeChanged="RightOperationPanel_SizeChanged"
                        Spacing="12">
                    <Expander IsExpanded="True"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <Grid MinHeight="64">
                                <StackPanel VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="模拟参数" />
                                    <TextBlock Style="{StaticResource DescriptionStyle}"
                                               Text="设置月度计划和生产月份" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <StackPanel Padding="16,4,16,16" Spacing="14">
                            <NumberBox x:Name="TotalQuantityBox"
                                       Header="月度焊接总数量"
                                       Minimum="0"
                                       SpinButtonPlacementMode="Hidden"
                                       PlaceholderText="请输入月度总量" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="生产月份" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="YearComboBox"
                                              Header="年份"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="MonthSelector_SelectionChanged" />
                                    <ComboBox Grid.Column="1"
                                              x:Name="MonthComboBox"
                                              Header="月份"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="MonthSelector_SelectionChanged" />
                                </Grid>
                                <TextBlock x:Name="DaysHintText"
                                           Style="{StaticResource DescriptionStyle}" />
                            </StackPanel>

                            <Button Height="40"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="GenerateButton_Click"
                                    Content="生成模拟数据" />
                            <TextBlock Style="{StaticResource DescriptionStyle}"
                                       TextWrapping="Wrap"
                                       Text="天数由月份自动计算，生成时会自动加入自然波动和周末减产。" />
                        </StackPanel>
                    </Expander>

                    <Button Height="40"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            x:Name="RedistributeButton"
                            IsEnabled="False"
                            Click="RedistributeButton_Click"
                            Content="确认调整并重新分配" />
                    <Button Height="40"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            x:Name="AutomaticImportButton"
                            IsEnabled="False"
                            Click="AutomaticImportButton_Click"
                            Content="自动导入 Notion" />
                    <StackPanel x:Name="DebugToolsPanel" Spacing="12" />
            </StackPanel>

            <Grid Grid.Row="1"
                  x:Name="ResultsContentGrid"
                  VerticalAlignment="Top"
                  RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar x:Name="ResultInfoBar"
                         IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Message="0 行数据 · 可修改特殊日期的产量，确认后系统会固定这些日期并重新分配其余产量。" />

                <Border Grid.Row="1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <ListView Grid.Row="0"
                          ItemsSource="{x:Bind Rows}"
                          SelectionMode="None"
                          Background="Transparent">
                    <ListView.Header>
                        <Grid Height="36" Padding="12,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="日期" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="焊接数量" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="Padding" Value="12,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DailyWeldRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="12">
                                    <TextBlock Text="{x:Bind DateText}" />
                                    <TextBlock Style="{StaticResource DescriptionStyle}"
                                               Text="{x:Bind Weekday}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <NumberBox x:Name="QuantityInputBox"
                                               Width="112"
                                               Minimum="0"
                                               SpinButtonPlacementMode="Hidden"
                                               Value="{x:Bind Quantity, Mode=TwoWay}"
                                               Tag="{Binding ElementName=ConfirmQuantityButton}"
                                               GotFocus="QuantityBox_GotFocus"
                                               ValueChanged="RowQuantityBox_ValueChanged" />
                                    <Grid Width="28" Height="28">
                                        <Button x:Name="ConfirmQuantityButton"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Tag="{Binding ElementName=QuantityInputBox}"
                                                Visibility="Collapsed"
                                                Click="ConfirmQuantityButton_Click">
                                            <Viewbox Width="14" Height="14">
                                                <Path Width="16"
                                                      Height="16"
                                                      Data="M 2.5,8.5 L 6.5,12.5 L 13.5,4.5"
                                                      Stroke="{ThemeResource SystemFillColorSuccessBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Viewbox>
                                        </Button>
                                        <Border x:Name="ManualStatusIndicator"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Visibility="{x:Bind IsManuallyAdjusted, Mode=OneWay}"
                                                ToolTipService.ToolTip="已手动修改">
                                            <Grid Width="20" Height="20">
                                                <Path Tag="CompletionRing"
                                                      Width="18"
                                                      Height="18"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 17.657,6.343 A 8,8 0 1 0 6.343,17.657 A 8,8 0 1 0 17.657,6.343"
                                                      Stretch="Uniform"
                                                      Stroke="{ThemeResource SystemFillColorSuccessBrush}"
                                                      StrokeThickness="1.35"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      StrokeDashArray="52,52"
                                                      StrokeDashOffset="0" />
                                                <Path Tag="CompletionCheck"
                                                      Width="13"
                                                      Height="13"
                                                      Margin="0,1.5,0,0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 2.4,7.4 C 3.7,8.7 4.8,9.9 6.1,11.1 C 8.3,8.8 10.4,6.4 12.7,4.1"
                                                      Stretch="Uniform"
                                                      Stroke="{ThemeResource SystemFillColorSuccessBrush}"
                                                      StrokeThickness="1.65"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      StrokeDashArray="18,18"
                                                      StrokeDashOffset="0" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="1"
                      MinHeight="68"
                      Padding="16,8,20,8"
                      ColumnSpacing="12"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="合计" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource DescriptionStyle}"
                                   Text="当前合计" />
                        <TextBlock x:Name="ActualTotalText"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="—" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource DescriptionStyle}"
                                   Text="月度计划" />
                        <TextBlock x:Name="PlannedTotalText"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="—" />
                    </StackPanel>
                    <InfoBar Grid.Column="3"
                             x:Name="TotalCheckInfoBar"
                             MinWidth="0"
                             Margin="8,0,0,0"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Title="等待生成数据" />
                </Grid>
                </Grid>
                </Border>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</Page>
