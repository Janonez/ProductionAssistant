<Page
    x:Class="ProductionAssistant.Pages.PlanPdfExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,24,32,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                       FontSize="28"
                       FontWeight="Bold"
                       Text="挂网计划 PDF" />
            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                       Text="选择目录后按顺序完成操作" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="16">
            <StackPanel Spacing="8">
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="选择月度目录" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderPathBox"
                             TextChanged="FolderPathBox_TextChanged"
                             PlaceholderText="选择挂网计划目录" />
                    <Button Grid.Column="1"
                            Click="BrowseButton_Click"
                            Content="选择目录" />
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollMode="Auto">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource CardStyle}"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="操作流程" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AuditButton"
                                        Height="40"
                                        MinWidth="92"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="AuditButton_Click"
                                        Content="检查" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="→" />
                                <Button x:Name="RepairButton"
                                        Height="40"
                                        MinWidth="92"
                                        IsEnabled="False"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="RepairButton_Click"
                                        Content="修复" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="→" />
                                <Button x:Name="ExportButton"
                                        Height="40"
                                        MinWidth="110"
                                        IsEnabled="False"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="ExportButton_Click"
                                        Content="导出PDF" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="→" />
                                <Button x:Name="OpenOutputButton"
                                        Height="40"
                                        MinWidth="130"
                                        IsEnabled="False"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="OpenOutputButton_Click"
                                        Content="打开导出目录" />
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                   Text="请按顺序点击，下一步完成后自动启用。" />

                        <ProgressBar x:Name="ExportProgressBar"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="11" />
                        <TextBlock x:Name="ExportProgressText"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="等待导出" />
                        <InfoBar x:Name="WorkspaceInfoBar"
                                 IsOpen="True"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="等待操作"
                                 Message="请选择目录。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Padding="16">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="检查结果" />
                            <TextBlock Grid.Column="1"
                                       x:Name="IssueCountText"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="尚未检查" />
                        </Grid>
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind Issues}"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="4,6"
                                               Text="{Binding Display}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
