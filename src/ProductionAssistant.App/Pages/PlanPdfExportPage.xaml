<Page
    x:Class="ProductionAssistant.Pages.PlanPdfExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ProductionAssistant.Controls">
    <controls:FileWorkflowShell x:Name="WorkflowShell">
        <controls:FileWorkflowShell.Details>
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="检查结果" />
                        <TextBlock Grid.Column="1" x:Name="IssueCountText"
                                   Foreground="{StaticResource MutedTextBrush}" Text="尚未检查" />
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind Issues}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="4,6" Text="{Binding Display}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </controls:FileWorkflowShell.Details>
    </controls:FileWorkflowShell>
</Page>
