<Page
    x:Class="ProductionAssistant.Pages.ProductionMeetingExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ProductionAssistant.Controls">
    <controls:FileWorkflowShell x:Name="WorkflowShell">
        <controls:FileWorkflowShell.Details>
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="输出规则" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                               Text="保留原始内容、公式、合并、隐藏行列和工作表设置；仅清除绿色或红色背景填充。输出 Sheet 顺序固定为：已发运项目、在制项目、预投项目。" />
                    <TextBlock x:Name="MeetingDateText" Text="开会日期：未读取" />
                    <TextBlock x:Name="OutputPathText" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" Text="输出文件：未生成" />
                </StackPanel>
            </Border>
        </controls:FileWorkflowShell.Details>
    </controls:FileWorkflowShell>
</Page>
