<Page
    x:Class="ProductionAssistant.Pages.ProductionMeetingExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="32,24,32,32" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="5">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                           FontSize="32"
                           FontWeight="Bold"
                           Text="生产会资料拆分" />
                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="选择只有一个 Sheet 的 Excel，按已发运、在制、预投三个分段生成独立 Sheet。" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="选择源文件" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilePathBox"
                                 IsReadOnly="True"
                                 PlaceholderText="请选择 .xlsx、.xlsm 或 .xls 文件"
                                 TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                x:Name="BrowseButton"
                                Click="BrowseButton_Click"
                                Content="选择源文件" />
                    </Grid>
                    <InfoBar x:Name="ResultInfoBar"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Title="等待选择"
                             Message="导出文件会生成在源文件所在目录，源文件不会被修改。" />
                    <ProgressRing x:Name="BusyRing"
                                  Width="24"
                                  Height="24"
                                  HorizontalAlignment="Left"
                                  IsActive="False"
                                  Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="输出规则" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="保留原始内容、公式、合并、隐藏行列和工作表设置；仅清除绿色或红色背景填充。输出 Sheet 顺序固定为：已发运项目、在制项目、预投项目。" />
                    <TextBlock x:Name="MeetingDateText"
                               Text="开会日期：未读取" />
                    <TextBlock x:Name="OutputPathText"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Text="输出文件：未生成" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
