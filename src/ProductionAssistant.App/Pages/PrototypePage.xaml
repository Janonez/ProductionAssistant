<Page
    x:Class="ProductionAssistant.Pages.PrototypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FAFAF9">
        <WebView2 x:Name="PrototypeWebView"
                  Visibility="Collapsed"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  NavigationCompleted="PrototypeWebView_NavigationCompleted" />
        <Grid x:Name="LoadingLayer" Background="#FAFAF9">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" AutomationProperties.Name="正在启动生产助手">
                <ProgressRing IsActive="True" Width="24" Height="24" />
                <TextBlock Text="正在启动生产助手…" />
            </StackPanel>
        </Grid>
        <Border x:Name="LoadError" Visibility="Collapsed"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="32">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE783;" FontSize="32" />
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="工作区暂时无法加载" />
                <TextBlock x:Name="LoadErrorText" TextWrapping="Wrap" TextAlignment="Center" />
                <Button HorizontalAlignment="Center" Content="重试加载" Click="Retry_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
