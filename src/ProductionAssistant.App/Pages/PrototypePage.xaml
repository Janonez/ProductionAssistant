<Page
    x:Class="ProductionAssistant.Pages.PrototypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <WebView2 x:Name="PrototypeWebView"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  NavigationCompleted="PrototypeWebView_NavigationCompleted" />
        <Border x:Name="LoadError"
                Visibility="Collapsed"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Padding="32">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE783;" FontSize="32" />
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="新版界面无法加载" />
                <TextBlock x:Name="LoadErrorText" TextWrapping="Wrap" TextAlignment="Center" />
                <Button HorizontalAlignment="Center" Content="返回原版界面" Click="ReturnToNative_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
