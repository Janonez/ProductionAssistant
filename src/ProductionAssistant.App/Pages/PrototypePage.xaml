<Page
    x:Class="ProductionAssistant.Pages.PrototypePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FAFAF9">
        <WebView2 x:Name="PrototypeWebView"
                  Visibility="Collapsed"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  NavigationCompleted="PrototypeWebView_NavigationCompleted" />
        <Grid x:Name="LoadingLayer" Background="#FAFAF9">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="SkeletonContent.MaxWidth" Value="960" /><Setter Target="SkeletonMessageColumn.Width" Value="360" /></VisualState.Setters>
                    </VisualState>
                    <VisualState>
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1321" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="SkeletonContent.MaxWidth" Value="1050" /><Setter Target="SkeletonMessageColumn.Width" Value="400" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.Resources>
                <Style x:Key="SkeletonBlock" TargetType="Border">
                    <Setter Property="Background" Value="#E7E5E4" />
                    <Setter Property="CornerRadius" Value="14" />
                    <Setter Property="Height" Value="16" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions><ColumnDefinition Width="222" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border BorderBrush="#E7E5E4" BorderThickness="0,0,1,0" Padding="20,32,20,24">
                <StackPanel Spacing="24" AutomationProperties.Name="正在加载生产助手">
                    <Border Style="{StaticResource SkeletonBlock}" Width="72" Height="20" HorizontalAlignment="Left" Margin="0,0,0,18" />
                    <Border Style="{StaticResource SkeletonBlock}" Width="64" HorizontalAlignment="Left" />
                    <Border Style="{StaticResource SkeletonBlock}" Height="32" />
                    <Border Style="{StaticResource SkeletonBlock}" Height="24" />
                    <Border Style="{StaticResource SkeletonBlock}" Height="24" />
                    <Border Style="{StaticResource SkeletonBlock}" Width="90" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    <Border Style="{StaticResource SkeletonBlock}" Height="24" />
                    <Border Style="{StaticResource SkeletonBlock}" Height="24" />
                    <Border Style="{StaticResource SkeletonBlock}" Height="24" />
                    <Border Style="{StaticResource SkeletonBlock}" Width="64" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    <Border Style="{StaticResource SkeletonBlock}" Height="24" />
                </StackPanel>
            </Border>
            <Grid x:Name="SkeletonContent" Grid.Column="1" Margin="40,76,40,0" MaxWidth="1050" VerticalAlignment="Top">
                <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="114" /><RowDefinition Height="560" /></Grid.RowDefinitions>
                <Border Style="{StaticResource SkeletonBlock}" Width="182" Height="30" HorizontalAlignment="Left" />
                <Border Style="{StaticResource SkeletonBlock}" Width="44" Height="44" HorizontalAlignment="Right" />
                <Grid Grid.Row="1" MaxWidth="760" Margin="0,22,0,30">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SkeletonBlock}" Width="136" Height="28" HorizontalAlignment="Left" />
                    <Border Grid.Column="1" Style="{StaticResource SkeletonBlock}" Width="136" Height="28" />
                    <Border Grid.Column="2" Style="{StaticResource SkeletonBlock}" Width="136" Height="28" HorizontalAlignment="Right" />
                </Grid>
                <Border Grid.Row="2" Background="White" BorderBrush="#E7E5E4" BorderThickness="1" CornerRadius="20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SkeletonMessageColumn" Width="400" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border BorderBrush="#E7E5E4" BorderThickness="0,0,1,0" Padding="30,28,30,36">
                            <StackPanel Spacing="16">
                                <Border Style="{StaticResource SkeletonBlock}" Width="80" HorizontalAlignment="Left" />
                                <Border Style="{StaticResource SkeletonBlock}" Height="32" />
                                <Border Style="{StaticResource SkeletonBlock}" Height="330" Margin="0,6,0,0" />
                                <Border Style="{StaticResource SkeletonBlock}" Width="116" Height="44" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Margin="24">
                            <Border Style="{StaticResource SkeletonBlock}" Width="88" HorizontalAlignment="Center" />
                            <Border Style="{StaticResource SkeletonBlock}" Width="220" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border x:Name="LoadError"
                Visibility="Collapsed"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Padding="32">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE783;" FontSize="32" />
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="工作区暂时无法加载" />
                <TextBlock x:Name="LoadErrorText" TextWrapping="Wrap" TextAlignment="Center" />
                <Button HorizontalAlignment="Center" Content="重试加载" Click="Retry_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
