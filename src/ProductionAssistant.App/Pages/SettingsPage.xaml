<Page
    x:Class="ProductionAssistant.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="SettingsPage_SizeChanged">
    <Page.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="OptionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="OptionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="OptionIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground"
                    Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="SettingsScrollViewer"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid x:Name="SettingsContentGrid"
              Padding="32,24,32,32"
              HorizontalAlignment="Left">
            <StackPanel HorizontalAlignment="Stretch" Spacing="10">
                <TextBlock Margin="0,0,0,8"
                           Style="{StaticResource TitleTextBlockStyle}"
                           FontSize="32" FontWeight="Bold" Text="设置" />

                <TextBlock Margin="0,10,0,4"
                           Style="{StaticResource SectionTitleStyle}"
                           Text="Notion" />

                <Expander Style="{StaticResource SettingsExpanderStyle}"
                          IsExpanded="False">
                    <Expander.Header>
                        <Grid MinHeight="64" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource OptionIconStyle}"
                                      Glyph="&#xE71B;" />
                            <StackPanel Grid.Column="1" Spacing="2"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource OptionTitleStyle}"
                                           Text="Notion 连接" />
                                <TextBlock Style="{StaticResource OptionDescriptionStyle}"
                                           Text="API 令牌和数据库根页面" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="0">
                        <Grid Height="56" Padding="16,0" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource OptionTitleStyle}"
                                           Text="API 令牌" />
                                <TextBlock Style="{StaticResource OptionDescriptionStyle}"
                                           Text="使用 Windows 当前用户加密后保存在本机" />
                            </StackPanel>
                            <PasswordBox Grid.Column="1" x:Name="TokenBox"
                                         VerticalAlignment="Center"
                                         PasswordRevealMode="Peek"
                                         PlaceholderText="secret_..." />
                        </Grid>
                        <Rectangle Height="1"
                                   HorizontalAlignment="Stretch"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid Height="56" Padding="16,0" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource OptionTitleStyle}"
                                           Text="根页面 ID（可选）" />
                                <TextBlock Style="{StaticResource OptionDescriptionStyle}"
                                           Text="留空时自动发现令牌有权访问的数据源" />
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="RootPageIdBox"
                                     VerticalAlignment="Center"
                                     PlaceholderText="留空则自动发现全部授权数据源" />
                        </Grid>
                        <Rectangle Height="1"
                                   HorizontalAlignment="Stretch"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid Height="56"
                              Padding="16,0"
                              ColumnSpacing="12"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <Button x:Name="SaveConnectionButton"
                                        Click="SaveButton_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Content="保存并连接" />
                                <Button x:Name="RefreshDataSourcesButton"
                                        Click="RefreshButton_Click"
                                        Content="刷新数据源" />
                                <ProgressRing x:Name="TestingRing" Width="20" Height="20"
                                              IsActive="False" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="7"
                                        VerticalAlignment="Center">
                                <FontIcon x:Name="ConnectionStatusIcon"
                                          FontSize="14"
                                          Visibility="Collapsed"
                                          Glyph="&#xE946;" />
                                <TextBlock x:Name="ConnectionStatusText"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource SettingsExpanderStyle}"
                          IsExpanded="False">
                    <Expander.Header>
                        <Grid MinHeight="64" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource OptionIconStyle}"
                                      Glyph="&#xE8B7;" />
                            <StackPanel Grid.Column="1" Spacing="2"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource OptionTitleStyle}"
                                           Text="数据源缓存" />
                                <TextBlock x:Name="CachedSourcesDescriptionText"
                                           Style="{StaticResource OptionDescriptionStyle}"
                                           Text="尚未缓存 Notion 数据源" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <Grid>
                        <ListView x:Name="CachedSourcesList"
                                  MaxHeight="360"
                                  Margin="0"
                                  Padding="0"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Height" Value="52" />
                                    <Setter Property="Padding" Value="16,0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="BorderBrush"
                                            Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="26" Height="26"
                                              VerticalAlignment="Center">
                                            <FontIcon FontSize="16"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      Glyph="&#xE8B7;" />
                                            <Image Width="24" Height="24"
                                                   Stretch="Uniform"
                                                   Source="{Binding IconUrl}" />
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="19"
                                                       Text="{Binding IconText}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}" />
                                            <TextBlock Margin="0,1,0,0"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding Path}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyCachedSourcesText"
                                   Padding="16,18"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="尚未缓存数据源，请点击“刷新数据源”获取。" />
                    </Grid>
                </Expander>

                <Expander Style="{StaticResource SettingsExpanderStyle}"
                          IsExpanded="False">
                    <Expander.Header>
                        <Grid MinHeight="64" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Style="{StaticResource OptionIconStyle}"
                                      Glyph="&#xE8AB;" />
                            <StackPanel Grid.Column="1" Spacing="2"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource OptionTitleStyle}"
                                           Text="工具绑定" />
                                <TextBlock Style="{StaticResource OptionDescriptionStyle}"
                                           Text="业务模块与 Notion 数据源的绑定结果" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <Grid>
                        <ListView x:Name="BindingsList" SelectionMode="None"
                                  Margin="0" Padding="0"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch" />
                                    <Setter Property="HorizontalAlignment"
                                            Value="Stretch" />
                                    <Setter Property="Height" Value="56" />
                                    <Setter Property="Padding" Value="16,0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="BorderBrush"
                                            Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Left"
                                          ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="16" VerticalAlignment="Center"
                                                  Foreground="{StaticResource BrandGreenBrush}"
                                                  Glyph="&#xE9D2;" />
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                                       Text="{Binding ModuleName}" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                       Text="● 已联通" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" VerticalAlignment="Center"
                                                  FontSize="14" Glyph="&#xE72A;" />
                                        <StackPanel Grid.Column="3"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="13"
                                                       Text="{Binding Name}" />
                                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding Path}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="12"
                                                       Text="{Binding DateProperty}" />
                                            <TextBlock FontSize="12"
                                                       Text="{Binding QuantityProperty}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyBindingsText"
                                   Padding="16,18"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="尚未建立工具绑定。请进入具体业务模块完成首次绑定。" />
                    </Grid>
                </Expander>

                <TextBlock Margin="0,24,0,4"
                           Style="{StaticResource SectionTitleStyle}"
                           Text="关于" />

                <Expander Style="{StaticResource SettingsExpanderStyle}">
                    <Expander.Header>
                        <Grid MinHeight="64" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="30" Height="30"
                                   Source="ms-appx:///Assets/production-assistant-logo.png" />
                            <StackPanel Grid.Column="1" Spacing="2"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource OptionTitleStyle}"
                                           Text="生产助手" />
                                <TextBlock Style="{StaticResource OptionDescriptionStyle}"
                                           Text="版本 1.5.0" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <Grid Height="56" Padding="16,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="16" VerticalAlignment="Center"
                                      Foreground="{StaticResource BrandGreenBrush}"
                                      Glyph="&#xE946;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                           Text="本地数据保护" />
                                <TextBlock FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="令牌使用 Windows 当前用户加密，配置仅保存在本机。" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid Height="56" Padding="16,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="16" VerticalAlignment="Center"
                                      Foreground="{StaticResource BrandGreenBrush}"
                                      Glyph="&#xE895;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                           Text="Notion API" />
                                <TextBlock FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="生产数据通过 Notion 官方接口读取和更新。" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
